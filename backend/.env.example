# Copiar a .env (NUNCA versionar el .env real) y llenar con valores reales.

# postgresql+asyncpg://usuario:password@db:5432/bazaria
DATABASE_URL=postgresql+asyncpg://bazaria:CAMBIAME@db:5432/bazaria

# Secreto para firmar JWT propios (32+ bytes aleatorios). Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAME

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=https://example.com

FOTOS_DIR=/data/fotos
FOTOS_BASE_URL=https://api.example.com/fotos

# Opcional: lista de correos permitidos, separados por coma.
ALLOWED_EMAILS=

# Panel de administración de sistemas (admin.example.com: /admin SQLAdmin
# y /flare fastapi-flare). Login PROPIO, separado del Google OAuth de las
# usuarias -- nunca usar las mismas credenciales ni el mismo secreto que
# JWT_SECRET.
ADMIN_USERNAME=CAMBIAME
ADMIN_PASSWORD=CAMBIAME
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=CAMBIAME

# Único dominio donde responde el panel (/admin, /flare). Vacío = cualquiera (solo desarrollo).
ADMIN_HOST=admin.example.com

# IP o subred del contenedor de Caddy en la red stack_stack (uvicorn solo confía en sus
# cabeceras X-Forwarded-*). Por defecto 127.0.0.1: no confía en nadie más.
FORWARDED_ALLOW_IPS=127.0.0.1

# Cuenta opcional de SOLO LECTURA del panel (colaborador): ve todo, no edita,
# no borra ni exporta. Vacío = la cuenta no existe. Contraseña mínimo 16 caracteres.
ADMIN_LECTOR_USERNAME=
ADMIN_LECTOR_PASSWORD=

# Variables solo usadas por el propio contenedor de postgres (docker-compose).
POSTGRES_DB=bazaria
POSTGRES_USER=bazaria
POSTGRES_PASSWORD=CAMBIAME

# Mostrar /docs, /redoc y /openapi.json (solo en desarrollo). En producción: false.
EXPONER_DOCS=false
